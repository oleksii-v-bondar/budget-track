# Copy to .env (never commit .env).

# Password for the bundled Postgres container (docker-compose only):
# openssl rand -hex 24 (hex keeps the connection URL valid)
POSTGRES_PASSWORD=

# 32 random bytes, base64: openssl rand -base64 32
# Encrypts the authenticator app's secret. Required even though the authenticator is off by default: it is used
# once you turn it on in Settings.
ENCRYPTION_KEY=

# One-time token you type into the first-run setup page (16–256 characters): openssl rand -hex 16
SETUP_TOKEN=

# Browsers only send Secure cookies over HTTPS (and http://localhost in most browsers).
# Set to false only for plain-http access on a trusted network. docker-compose.yml binds the port to 127.0.0.1,
# so LAN access also needs that port mapping changed.
COOKIE_SECURE=true

# true only when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

LOG_LEVEL=info
APP_PORT=3000

# `npm run dev` needs your own Postgres 16, e.g.
# `docker run -d -p 127.0.0.1:5432:5432 -e POSTGRES_PASSWORD=dev postgres:16-alpine`
# and `DATABASE_URL=postgres://postgres:dev@localhost:5432/postgres`
# With `npm run dev:web` (http://localhost:5173), run the API on the port it forwards /api to: `PORT=3080`
